# Modelo para EnvironmentFile do systemd. Nao executar com source.
# Copiar para /etc/techhelp/techhelp.env no servidor, com dono root e modo 600.
# Preencher com banco existente e usuario proprio da aplicacao antes de iniciar.
TECHHELP_DB_URL="jdbc:mariadb://127.0.0.1:3306/tech_help"
TECHHELP_DB_USERNAME="SUBSTITUIR_USUARIO_DA_APLICACAO"
TECHHELP_DB_PASSWORD="SUBSTITUIR_SENHA_REAL_SOMENTE_NO_SERVIDOR"
TECHHELP_PORT=8080
